{
  "name": "edgebuilder",
  "version": "0.9.1",
  "private": true,
  "description": "A world builder for Cyberpunk 2077 that runs inside the game on REDnode.",
  "license": "MIT",
  "repository": "github:Edgemodders/EDGEbuilder",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p . && node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package": "npm run build && node tools/release/zip.mjs",
    "nexus:pull": "node tools/nexus/nexus.mjs pull",
    "nexus:status": "node tools/nexus/nexus.mjs status"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
